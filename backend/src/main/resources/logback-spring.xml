<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="logs"/>

    <appender name="SIMULATION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/simulation.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/simulation.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="INDIVIDUAL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/individual.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/individual.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>3</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.morapack.skyroute.simulation" level="INFO" additivity="false">
        <appender-ref ref="SIMULATION_FILE"/>
    </logger>

    <logger name="com.morapack.skyroute.algorithm.GeneticAlgorithm" level="INFO">
        <appender-ref ref="SIMULATION_FILE"/>
    </logger>

    <logger name="com.morapack.skyroute.algorithm.RouteBuilder" level="OFF" additivity="false"/>

    <logger name="com.morapack.skyroute.algorithm" level="DEBUG" additivity="false">
        <appender-ref ref="INDIVIDUAL_FILE"/>
    </logger>

    <!-- Fall back to Spring Boot default console logging for other packages -->
    <root level="INFO">
        <appender-ref ref="SIMULATION_FILE"/>
    </root>
</configuration>
